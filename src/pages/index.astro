---
import { ArrowUpRight, DoorOpen, Heart } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BrandLogo from '../components/BrandLogo.astro';
import HeroWindow from '../components/HeroWindow.astro';
import Products from '../components/Products.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import Questions from '../components/Questions.astro';
import { copy, navigation } from '../config/content';
import { site, getWhatsAppHref, getPhoneHref } from '../config/site';
---
<BaseLayout>
  <Header />
  <main id="contenido" tabindex="-1">
    <HeroWindow />
    <Products />
    <section id="nosotros" class="about section-pad" aria-labelledby="about-title">
      <p class="eyebrow section-index" data-reveal><span>02</span> / JL Aberturas</p>
      <div class="about-heading" data-reveal>
        <h2 id="about-title">{copy.about.heading.map(line => <span>{line}</span>)}</h2>
        <div class="about-frame" aria-hidden="true"><span></span></div>
      </div>
      <div class="about-bottom" data-reveal><p class="about-note">{copy.about.note}</p><p class="about-description">{copy.about.description}</p></div>
    </section>
    <Process />
    <Gallery />
    <Location />
    <Questions />
    <section id="contacto" class="contact section-pad" aria-labelledby="contact-title">
      <p class="eyebrow section-index" data-reveal><span>06</span> / Hablemos de tu proyecto</p>
      <div class="contact-main" data-reveal><h2 id="contact-title">{copy.contact.headingFirst}<br />{copy.contact.headingSecond} <span>{copy.contact.headingLast}</span></h2><DoorOpen class="contact-door" size={72} stroke-width={1.15} aria-hidden="true" /></div>
      <div class="contact-bottom" data-reveal><p>{copy.contact.description}</p><div class="contact-action"><WhatsAppLink label="Consultar por WhatsApp" variant="large" placement="contact" /><span>Atención directa · <a class="phone-link" href={getPhoneHref()} aria-label={`Llamar a JL Aberturas al ${site.displayPhone}`}>{site.displayPhone}</a></span></div></div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="footer-top"><BrandLogo variant="footer" /><nav aria-label="Navegación del pie">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav><a class="text-link" href={getWhatsAppHref()} data-whatsapp-placement="footer">WhatsApp <ArrowUpRight class="external-arrow" size={16} aria-hidden="true" /></a></div>
    <div class="footer-business"><div class="footer-socials" aria-label="Redes sociales">{site.socialProfiles.map(profile => <a class="text-link" href={profile.url} target="_blank" rel="noopener noreferrer">{profile.name}<ArrowUpRight class="external-arrow" size={14} aria-hidden="true" /></a>)}</div><address><a href="#ubicacion">{site.address.streetAddress} · {site.address.addressLocality}</a></address></div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.businessName}</span>
      <p class="footer-credit">Hecho con <Heart size={13} stroke-width={1.7} fill="currentColor" aria-hidden="true" /><span class="sr-only">amor</span> por <a href="https://ramita.dev">Ramiro Garcia</a></p>
    </div>
  </footer>
</BaseLayout>
