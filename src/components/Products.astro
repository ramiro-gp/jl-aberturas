---
import { Picture } from 'astro:assets';
import { ArrowDownRight } from '@lucide/astro';
import { copy, products, roofProduct } from '../config/content';
import ProductViews from './ProductViews.astro';
import ProductOptions from './ProductOptions.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---
<section id="productos" class="products section-pad" aria-labelledby="products-title">
  <div class="section-heading" data-reveal>
    <p class="eyebrow section-index"><span>01</span> / Nuestros productos</p>
    <div class="section-heading-main"><h2 id="products-title">{copy.products.headingFirst}<br /><span>{copy.products.headingSecond}</span></h2><p>{copy.products.intro}</p></div>
  </div>
  <div class="product-grid">
    {products.map((product, index) => (
      <article class="product" data-product={product.id} data-reveal>
        <ProductViews id={product.id} views={product.views} index={index} />
        <div class="product-caption"><h3>{product.name}</h3><p>{product.description}</p></div>
      </article>
    ))}
  </div>
  <article class="product-roof" data-reveal>
    <div class="roof-photo">
      <Picture src={roofProduct.image} alt={roofProduct.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 43vw, 88vw" formats={['avif', 'webp']} fallbackFormat="jpg" quality={76} loading="lazy" decoding="async" />
    </div>
    <div class="roof-copy"><p class="eyebrow">Otra forma de sumar luz</p><h3>{roofProduct.name}</h3><p>{roofProduct.description}</p><span class="roof-image-note">Ambiente ilustrativo generado con IA.</span></div>
  </article>
  <article class="product-custom" data-reveal>
    <div class="custom-diagram" aria-hidden="true"><span class="measure-line measure-top"></span><span class="measure-line measure-side"></span><span class="custom-frame"><span></span></span><ArrowDownRight size={24} /></div>
    <div><span class="eyebrow">Tu idea, tus medidas</span><h3>{copy.products.customHeading}</h3><p>{copy.products.customDescription}</p></div>
  </article>
  <p class="image-note">Imágenes ilustrativas. Las opciones se definen según cada proyecto.</p>
  <div class="product-consultation" data-reveal>
    <div><p class="eyebrow">El próximo paso</p><h3>¿Qué abertura tenés en mente?</h3><p>Mandanos una foto o las medidas aproximadas. Te ayudamos a definirla.</p></div>
    <WhatsAppLink label="Consultar por estas aberturas" placement="products" />
  </div>
  <ProductOptions />
</section>
