---
import { ArrowUpRight } from '@lucide/astro';
import { getWhatsAppHref } from '../config/site';
import type { WhatsAppPlacement } from '../config/measurement';
interface Props { label?: string; variant?: 'primary' | 'header' | 'large'; placement: WhatsAppPlacement; }
const { label = 'Pedir presupuesto', variant = 'primary', placement } = Astro.props;
---
<a href={getWhatsAppHref()} data-whatsapp-placement={placement} class:list={['whatsapp-link', `whatsapp-${variant}`]}>
  <span>{label}</span><ArrowUpRight size={20} aria-hidden="true" />
</a>
