---
import { ArrowUpRight } from '@lucide/astro';
import { getWhatsAppHref } from '../config/site';
interface Props { label?: string; variant?: 'primary' | 'header' | 'large'; }
const { label = 'Pedir presupuesto', variant = 'primary' } = Astro.props;
---
<a href={getWhatsAppHref()} class:list={['whatsapp-link', `whatsapp-${variant}`]}>
  <span>{label}</span><ArrowUpRight size={20} aria-hidden="true" />
</a>
