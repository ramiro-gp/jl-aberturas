---
import { ArrowDown, MoveRight } from '@lucide/astro';
import { copy } from '../config/content';
import WhatsAppLink from './WhatsAppLink.astro';
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-scene">
    <div class="hero-top">
      <p class="eyebrow"><span class="status-mark" aria-hidden="true"></span>{copy.hero.activity}</p>
      <div class="hero-heading-row">
        <h1 id="hero-title">{copy.hero.titleFirst}<br /><span>{copy.hero.titleSecond}</span></h1>
        <div class="hero-aside" aria-hidden="true"><span>Luz. Espacio.<br />Una nueva perspectiva.</span><span class="hero-aside-line"></span><span>JL / 01</span></div>
      </div>
    </div>
    <div class="window-composition">
      <div class="window-shell" aria-hidden="true">
        <div class="window-view">
          <svg class="architectural-view" viewBox="0 0 1400 580" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="wall-light" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#e9e4d8"/><stop offset="1" stop-color="#f8f5e9"/></linearGradient>
              <linearGradient id="sky-light" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#b9ccca"/><stop offset="1" stop-color="#e5e8dc"/></linearGradient>
              <linearGradient id="floor-light" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#c5bfac"/><stop offset="1" stop-color="#e2dccb"/></linearGradient>
            </defs>
            <path fill="url(#wall-light)" d="M0 0h1400v580H0z"/>
            <path fill="url(#sky-light)" d="M740 0h660v376H740z"/>
            <path fill="#c7c8b5" d="M740 288h660v88H740z"/>
            <path fill="#a7ae99" d="M740 324h660v52H740z"/>
            <path fill="#e8e3d5" d="M740 0h46v394h-46zM1230 0h170v394h-170z"/>
            <path fill="#d5cfbe" d="M786 0h18v394h-18z"/>
            <path fill="url(#floor-light)" d="M0 394h1400v186H0z"/>
            <path fill="#f6f1df" d="m804 394 426 0-116 186H589z"/>
            <g fill="none" stroke="#ada795" stroke-width="1.4" opacity=".65"><path d="M0 468h1400M0 555h1400M325 394 191 580M630 394 581 580M960 394 1059 580M1224 394 1400 568"/></g>
            <path fill="#b0b59d" d="M1100 313h50v81h-50z"/>
            <path fill="#858e74" d="M1119 310c-37-27-45-64-31-82 29 12 39 48 37 78 4-45 15-83 36-88 12 28-9 67-30 89 25-26 45-32 55-25-8 24-29 34-56 32z"/>
            <path fill="#847f6f" d="M1146 367h-43l7 27h29z"/>
          </svg>
        </div>
        <div class="window-leaf leaf-fixed"><span class="leaf-handle"></span><span class="glass-reflection"></span></div>
        <div class="window-leaf leaf-moving"><span class="leaf-handle"></span><span class="glass-reflection"></span></div>
        <div class="window-track"></div>
      </div>
      <div class="hero-reveal">
        <span class="eyebrow reveal-label">Tu próximo proyecto empieza acá</span>
        <p>{copy.hero.description}</p>
        <WhatsAppLink />
      </div>
      <span class="window-caption" aria-hidden="true">Diseñada para abrir posibilidades <MoveRight size={22} /></span>
    </div>
    <div class="hero-bottom">
      <p class="scroll-hint"><span class="scroll-line" aria-hidden="true"></span>Deslizá y abrí tu espacio</p>
      <a class="text-link" href="#productos">Ver productos <ArrowDown size={17} aria-hidden="true" /></a>
    </div>
  </div>
</section>
